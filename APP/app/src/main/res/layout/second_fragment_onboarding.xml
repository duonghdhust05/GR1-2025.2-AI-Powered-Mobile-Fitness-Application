<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorDarkBg"
    android:orientation="vertical"
    tools:context=".onboarding.FirstOnboardingFragment">

    <!-- FrameLayout to contain background image and overlay -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- Background image -->
        <ImageView
            android:layout_width="match_parent"
            android:layout_height="439dp"
            android:contentDescription="@string/equipment_description"
            android:scaleType="fitXY"
            android:src="@drawable/equipment2" />

        <!-- ImageView for the overlay -->
    </FrameLayout>

    <!-- Main title -->
    <TextView
        android:id="@+id/textView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="5dp"
        android:gravity="center"
        android:text="@string/elevate_your_workout_experience"
        android:textColor="@color/colorTextDarkPrimary"
        android:fontFamily="@font/outfit"
        android:textSize="32sp"
        android:textStyle="bold" />

    <!-- Sub title -->
    <TextView
        android:id="@+id/textView2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="0dp"
        android:gravity="center"
        android:text="@string/empower_your_fitness_journey"
        android:textColor="@color/colorTextDarkSecondary"
        android:fontFamily="@font/outfit"
        android:textSize="22sp" />

</LinearLayout>
