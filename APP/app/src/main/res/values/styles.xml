<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Fitnest Typography System -->
    <style name="TextAppearance.App.Headline" parent="TextAppearance.Material3.HeadlineMedium">
        <item name="android:textSize">24sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/black</item>
        <item name="fontFamily">@font/poppins</item>
        <item name="android:fontFamily">@font/poppins</item>
    </style>

    <style name="TextAppearance.App.Title" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:textSize">20sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/black</item>
        <item name="fontFamily">@font/poppins</item>
        <item name="android:fontFamily">@font/poppins</item>
    </style>

    <style name="TextAppearance.App.Body" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/gray_1</item>
        <item name="fontFamily">sans-serif</item> <!-- Android built-in Inter equivalent -->
        <item name="android:fontFamily">sans-serif</item>
    </style>

    <style name="TextAppearance.App.Label" parent="TextAppearance.Material3.LabelMedium">
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/gray_2</item>
        <item name="fontFamily">sans-serif</item>
        <item name="android:fontFamily">sans-serif</item>
    </style>

    <!-- Fitnest Widget Styles -->
    <style name="Widget.App.CardView" parent="Widget.Material3.CardView.Elevated">
        <item name="cardCornerRadius">20dp</item> <!-- Typical Fitnest Card Radius -->
        <item name="cardElevation">8dp</item>
        <item name="cardBackgroundColor">@color/bg_white</item>
        <item name="strokeWidth">0dp</item>
    </style>

    <style name="Widget.App.Button" parent="Widget.Material3.Button">
        <item name="cornerRadius">99dp</item> <!-- Pill shape -->
        <item name="backgroundTint">@color/brand_color_1</item>
        <item name="android:textColor">@color/bg_white</item>
        <item name="fontFamily">@font/poppins</item>
        <item name="android:fontFamily">@font/poppins</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">16sp</item>
        <item name="android:paddingVertical">16dp</item>
    </style>

    <!-- Custom Style for NavBar Indicator -->
    <style name="Widget.App.BottomNavIndicator" parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <!-- Thay đổi màu của indicator -->
        <item name="android:color">@color/brand_color_1</item>
    </style>
</resources>
